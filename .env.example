# ==========================================
# JARVIS AGENTIC OS - ENVIRONMENT VARIABLES
# ==========================================

# -----------------
# 1. API & SERVER
# -----------------
BACKEND_PORT=8005
FRONTEND_PORT=3005
BACKEND_URL=http://localhost:8005
FRONTEND_URL=http://localhost:3005

# -----------------
# 2. PTERODACTYL
# -----------------
PTERODACTYL_PANEL_URL=http://192.168.1.24:8085
PTERODACTYL_CLIENT_API_KEY=your_client_api_key_here
PTERODACTYL_APPLICATION_API_KEY=your_app_api_key_here

# -----------------
# 3. DOCKER
# -----------------
DOCKER_SOCKET_PATH=unix:///var/run/docker.sock

# -----------------
# 4. OBSIDIAN
# -----------------
OBSIDIAN_VAULT_PATH=/home/snow/homelab/homelab/obsidian
OBSIDIAN_DAILY_NOTES_PATH=/home/snow/homelab/homelab/obsidian/Daily_Notes

# -----------------
# 5. AI ENGINE (Gemini)
# -----------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# -----------------
# 6. SECURITY
# -----------------
SECRET_KEY=generate_a_random_secret_key_here
WS_AUTH_TOKEN=generate_a_random_ws_token_here
